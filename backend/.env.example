# Copie ce fichier en .env pour tester en local. NE JAMAIS committer .env.
# Sur Render, ces valeurs se saisissent dans Environment > Environment Variables.

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé SECRÈTE (sb_secret_... ou l'ancienne "service_role") : backend uniquement
SUPABASE_SECRET_KEY=

# Stripe > Développeurs > Clés API (sk_test_... pour tester, sk_live_... en production)
STRIPE_SECRET_KEY=
# Stripe > Développeurs > Webhooks > ton endpoint > Clé de signature (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Adresse publique du site (sans / final)
FRONTEND_URL=https://datanovicearea.com
# Origines autorisées à appeler l'API, séparées par des virgules
ALLOWED_ORIGINS=https://datanovicearea.com,https://www.datanovicearea.com
